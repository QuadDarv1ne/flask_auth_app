# Секретный ключ для приложения Flask
SECRET_KEY=1337

# Строка подключения к базе данных
SQLALCHEMY_DATABASE_URI=sqlite:///instance/site.db

# Настройки для работы с почтой
MAIL_SERVER=smtp.gmail.com          # Сервер SMTP (например, Gmail)
MAIL_PORT=587                       # Порт для TLS
MAIL_USE_TLS=true                   # Использование TLS
MAIL_USERNAME=your_email@gmail.com  # Ваш email для отправки писем
MAIL_PASSWORD=your_email_password   # Пароль приложения или учетной записи

# Настройки для работы с SSL
SSL_KEY_PASSWORD=sample_password           # Пароль для ключа SSL
SSL_KEY_PATH=certificate\certificate.crt   # Путь к ключу SSL
SSL_CERT_PATH=certificate\private.key      # Путь к сертификату SSL

# SSL_KEY_PATH=instance/ssl/key.pem
# SSL_CERT_PATH=instance/ssl/cert.pem
